# Copy to .env and fill in. The .env file is git-ignored.
ANTHROPIC_API_KEY=

# The model that answers questions. It needs a price in src/askwh/llm.py.
# MODEL=claude-haiku-5-5

# Spending cap for the app, in USD. Calls are refused once it is reached.
# BUDGET_USD=5

# Digests and alerts are also POSTed here as {"text": ...}, the shape Slack webhooks accept.
# WEBHOOK_URL=

# Set to false to stop the simulated stream of new orders.
# LIVE_INGEST=true
